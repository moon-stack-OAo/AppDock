# cp .env.example .env 后填写；.env 勿提交
# 说明：docs/PRD.md §15 · 密钥后果：docs/ops/BACKUP.md

APPDOCK_PORT=3080
# 开发监听地址；0.0.0.0 允许局域网访问
APPDOCK_HOST=0.0.0.0
APPDOCK_PUBLIC_BASE_URL=https://dock.example.com
# Compose / 容器内用绝对路径；本地开发用相对仓库根（scripts 会解析）
APPDOCK_DATABASE_URL=file:/data/appdock.db
# 本地示例：file:data/appdock.db
APPDOCK_STORAGE_ROOT=/data/files
# 本地示例：data/files

# —— 安全（上线必改）——
APPDOCK_JWT_SECRET=change-me-long-random
APPDOCK_JWT_ACCESS_TTL_SEC=3600
APPDOCK_JWT_REFRESH_TTL_SEC=604800
# 丢失则历史口令无法 reveal，只能轮换
APPDOCK_ACCESS_CODE_MASTER_KEY=base64-or-hex-32bytes-min
APPDOCK_ACCESS_CODE_SESSION_TTL_SEC=604800

APPDOCK_ADMIN_USERNAME=admin
APPDOCK_ADMIN_PASSWORD=change-me-on-first-boot
# 可选；缺省为 {username}@localhost
# APPDOCK_ADMIN_EMAIL=admin@localhost

# —— 同步（不用 GitHub 可留空）——
APPDOCK_GITHUB_TOKEN=
APPDOCK_WEBHOOK_SECRET=
APPDOCK_DEFAULT_POLL_INTERVAL_SEC=300

# —— 基础设施 ——
APPDOCK_REDIS_URL=redis://redis:6379
APPDOCK_QUEUE_DOWNLOAD_CONCURRENCY=3
APPDOCK_MAX_ASSET_SIZE_BYTES=1073741824

# —— 可选：首次种子 SMTP（settings 表已有 smtp 行后不再用环境变量覆盖）——
# 密码加密优先用 APPDOCK_ACCESS_CODE_MASTER_KEY；未设置时才用 APPDOCK_JWT_SECRET 派生。
# APPDOCK_SMTP_ENABLED=false
# APPDOCK_SMTP_HOST=
# APPDOCK_SMTP_PORT=587
# APPDOCK_SMTP_ENCRYPTION=starttls
# APPDOCK_SMTP_USER=
# APPDOCK_SMTP_PASS=
# APPDOCK_SMTP_FROM_NAME=AppDock
# APPDOCK_SMTP_FROM_EMAIL=
# APPDOCK_SMTP_REPLY_TO=
# APPDOCK_SMTP_CONNECT_TIMEOUT_SEC=15
# APPDOCK_NOTIFY_GLOBAL_EMAILS=

# —— 二期 ——
# APPDOCK_GITEE_TOKEN=
# APPDOCK_GITLAB_TOKEN=
