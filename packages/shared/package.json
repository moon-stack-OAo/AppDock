{
  "name": "@appdock/shared",
  "version": "0.0.1",
  "private": true,
  "description": "AppDock 共用类型与常量",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
