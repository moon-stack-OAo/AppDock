{
  "name": "@appdock/server",
  "version": "0.0.1",
  "private": true,
  "description": "AppDock NestJS API + Worker",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "node scripts/run-with-env.cjs -- nest start --watch",
    "start:prod": "node scripts/run-with-env.cjs -- node dist/main.js",
    "start:worker": "node scripts/run-with-env.cjs -- node dist/worker.main.js",
    "start:worker:dev": "node scripts/run-with-env.cjs -- ts-node -r tsconfig-paths/register src/worker.main.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "node scripts/run-with-env.cjs -- prisma db push",
    "prisma:migrate": "node scripts/run-with-env.cjs -- prisma migrate dev",
    "seed": "node scripts/run-with-env.cjs -- ts-node -r tsconfig-paths/register prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@appdock/shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
